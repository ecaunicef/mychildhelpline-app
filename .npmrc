# react@19 vs. transitive peer ranges.
#
# Several dependencies still declare peerDependencies of react "^17 || ^18"
# (react-native-fast-image, react-localization via react-native-localization,
# @dicebear/notionists via rn-customize-avatar). The project runs react 19.1.4,
# so npm >= 7 strict peer resolution hard-fails `npm ci` on a clean checkout.
#
# node_modules on existing dev machines was installed with this flag set
# manually; recording it here keeps local installs and CI identical instead of
# depending on whatever flags happened to be typed first.
legacy-peer-deps=true
